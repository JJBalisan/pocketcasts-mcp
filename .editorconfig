# Google style defaults; see https://google.github.io/styleguide/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.py]
indent_style = space
indent_size = 4

[*.{sh,bash,js,mjs,ts,html,css,json,yml,yaml,astro}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
